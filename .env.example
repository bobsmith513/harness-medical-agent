# ============================================================================
# harness-medical-agent 环境变量样例
#
# 复制为 .env 后按需填写（cp .env.example .env）。
# 未填写的项自动降级到 mock / 本地实现，零依赖即可跑通全部 demo。
#
# 约定：前缀 HARNESS_ + 嵌套分隔符 __（双下划线）
# ============================================================================

# ----------------------------------------------------------------------------
# ★ 在线调用模式（最简起步：两行配置即可运行 run_online.py）
# ----------------------------------------------------------------------------
# provider 填预设服务商名，端点与推荐模型名自动解析（llm/providers.py 预设表）：
#   deepseek    → https://api.deepseek.com/v1（deepseek-reasoner / deepseek-chat）
#   qwen        → 阿里云百炼兼容模式（qwen-max / qwen-plus / qwen-turbo）
#   zhipu       → 智谱开放平台（glm-4-plus / glm-4-air）
#   moonshot    → 月之暗面（moonshot-v1-8k / 32k / 128k）
#   openai      → OpenAI 官方（gpt-4o 系列）
#   siliconflow → 硅基流动聚合平台（托管多家开源模型）
# mock（默认，零依赖演示）| 通用 OpenAI 兼容端点请用逐角色 BASE_URL 覆盖
# HARNESS_LLM__PROVIDER=deepseek
#
# 共享 API Key（全部角色复用；逐角色可用 <ROLE>_API_KEY 独立覆盖）
# 申请入口见 llm/providers.py 的 key_portal 字段
# HARNESS_LLM__API_KEY=
#
# 填好上面两行后运行：
#   uv run python examples/run_online.py
#   → 交互问诊：选患者 → 提问 → 白盒输出路由/证据/推理链/门禁/结论

# ----------------------------------------------------------------------------
# 微调模型旁路（可选：推理专家指向本地 vLLM 的 SFT+DPO 微调模型）
# ----------------------------------------------------------------------------
# 留空 = 推理专家与其他角色共用在线 API（纯在线形态）
# 填本地端点 = 混合部署（推理走微调模型，路由/judge 继续在线）
# HARNESS_LLM__REASONING_BASE_URL=http://localhost:8001/v1
# 本地 vLLM 可填 EMPTY
# HARNESS_LLM__REASONING_API_KEY=EMPTY
# HARNESS_LLM__REASONING_MODEL=sft-dpo-aligned
# HARNESS_LLM__REASONING_TIMEOUT_S=120

# ----------------------------------------------------------------------------
# 逐角色覆盖（可选：任一字段留空即继承 provider 预设 / 共享 Key）
# ----------------------------------------------------------------------------
# 可覆盖角色：ORCHESTRATOR / REASONING / JUDGE / ROUTER
# 每个角色支持 _BASE_URL / _API_KEY / _MODEL / _TIMEOUT_S 四项
# 示例（judge 换独立端点与模型）：
# HARNESS_LLM__JUDGE_BASE_URL=https://api.moonshot.cn/v1
# HARNESS_LLM__JUDGE_API_KEY=sk-judge-xxx
# HARNESS_LLM__JUDGE_MODEL=moonshot-v1-8k

# ----------------------------------------------------------------------------
# 检索与记忆供给层
# ----------------------------------------------------------------------------
# local（默认：本地 numpy 向量 + BM25，零 Docker） | milvus（docker-compose 启动）
# HARNESS_RETRIEVAL__STORE=local
# 待填：Milvus 连接串，如 http://localhost:19530
# HARNESS_RETRIEVAL__MILVUS_URI=
# 嵌入实现：hashing（默认，零依赖） | bge（uv sync --extra bge，sentence-transformers）
# HARNESS_RETRIEVAL__EMBEDDING_PROVIDER=hashing
# HARNESS_RETRIEVAL__EMBEDDING_MODEL=BAAI/bge-large-zh
# HARNESS_RETRIEVAL__EMBEDDING_DIM=1024
# HARNESS_RETRIEVAL__DENSE_TOP_K=8
# HARNESS_RETRIEVAL__SPARSE_TOP_K=8
# HARNESS_RETRIEVAL__RRF_K=60
# bge-reranker-v2-m3 精排（本地重模型，默认关闭走 identity）
# HARNESS_RETRIEVAL__RERANKER_ENABLED=false
# HARNESS_RETRIEVAL__RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# HARNESS_RETRIEVAL__RERANK_TOP_K=5

# ----------------------------------------------------------------------------
# 虚拟文件系统与上下文压缩
# ----------------------------------------------------------------------------
# HARNESS_VFS__ROOT_DIR=.data/vfs
# 上下文只保留最近 N 轮 + 文件指针
# HARNESS_VFS__RECENT_TURNS=3
# 摘要写入 /memories/ 前强制走审核队列（合规默认开）
# HARNESS_VFS__MEMORY_REVIEW_REQUIRED=true

# ----------------------------------------------------------------------------
# 代码执行沙箱
# ----------------------------------------------------------------------------
# mock（默认：本地子进程） | opensandbox（Docker/K8s 双运行时）
# HARNESS_SANDBOX__BACKEND=mock
# 待填：OpenSandbox 服务地址
# HARNESS_SANDBOX__OPENSANDBOX_URL=
# HARNESS_SANDBOX__CHECKPOINT_EVERY_TURNS=5

# ----------------------------------------------------------------------------
# 可观测与审计（全部留空时自动降级：Noop tracer / SQLite / 内存实现）
# ----------------------------------------------------------------------------
# 待填：自托管 Langfuse
# HARNESS_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
# HARNESS_OBSERVABILITY__LANGFUSE_SECRET_KEY=
# HARNESS_OBSERVABILITY__LANGFUSE_HOST=
# 待填：PostgreSQL 审计库 DSN（留空降级 SQLite）
# HARNESS_OBSERVABILITY__AUDIT_DSN=
# 待填：Redis 连接（留空降级内存缓存与锁）
# HARNESS_OBSERVABILITY__REDIS_URL=

# ----------------------------------------------------------------------------
# 硬规则安全层（M2）
# ----------------------------------------------------------------------------
# 待填：生产药名词典 JSON 路径（归一化名/别名/ATC/交叉反应组），
# 留空使用内置合成种子词典；示例格式见 data/drug_dictionary.json
# HARNESS_SAFETY__DICTIONARY_PATH=

# ----------------------------------------------------------------------------
# 主 Agent 编排层（M4）
# ----------------------------------------------------------------------------
# 专家声明式 YAML 路径（留空 = 仓库根 configs/experts.yaml，开发态默认）
# HARNESS_ORCHESTRATOR__EXPERTS_CONFIG_PATH=

# ----------------------------------------------------------------------------
# 应用级
# ----------------------------------------------------------------------------
# HARNESS_APP__DEBUG=false
# 本地运行时数据根目录（mock 存储 / VFS / SQLite）
# HARNESS_APP__DATA_DIR=.data
